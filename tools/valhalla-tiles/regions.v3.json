{
  "_comment": "Which OSM extract each maps-v3 asset is built from, and which region ids resolve to it. An optional bbox (minLon,minLat,maxLon,maxLat) cuts the extract before building: Geofabrik ships the US south whole, but its tiles exceed GitHub's 2 GiB asset limit, so it is split on the client's own bounding boxes widened by roughly a degree.",
  "_clusters_comment": "A cluster is ONE valhalla_build_tiles run over several merged extracts, sliced afterwards into release assets under 2 GiB. It exists because Valhalla tiles are not independent: a directed edge stores its end node as a GraphId carrying the neighbour tile's node *index*, and that index is handed out while that tile is built. Two countries built separately therefore number the shared border cell differently, and a corridor drawn from both routes onto whatever node now sits at that index -- wrong roads, no error. Everything inside one cluster comes from one build, so every border inside it joins up. Each cluster carries its own build id, which keeps its tiles in their own pool on the phone and makes mixing two clusters structurally impossible rather than merely discouraged. A region id may appear in several clusters (France is in eu_alps and eu_iberia); the client prefers whichever cluster covers more of the route.",
  "clusters": [
    {
      "cluster": "eu_alps_core",
      "_why": "The western Alps either side of the France-Italy frontier: Chamonix, the Mont Blanc, Aosta, Turin, Geneva and the Valais. Cut from Geofabrik's alpine extract with a bounding box because the whole extract is 2.3 GB and tiling it was OOM-killed in a Docker VM allotted 7.75 GB -- the machine has 16 GB, the VM does not. It claims ch_full, fr_full and it_full while holding a corner of each, which is safe: a cluster is chosen by the ground it holds, and a Trek in Zurich or Brittany falls through to that country's own asset.",
      "geofabrik": [
        "europe/alps"
      ],
      "ids": [
        "ch_full",
        "fr_full",
        "it_full"
      ],
      "bbox": "5.5,44.0,9.6,47.1"
    },
    {
      "cluster": "eu_alps",
      "_why": "Every border the app's users actually cross in one build: Monte Carlo, the Alpine passes, the Mille Miglia, Bavaria and the Benelux runs all stay inside it.",
      "geofabrik": [
        "europe/dach",
        "europe/france",
        "europe/italy",
        "europe/slovenia",
        "europe/belgium",
        "europe/netherlands",
        "europe/luxembourg",
        "europe/czech-republic"
      ],
      "ids": [
        "de_full",
        "at_full",
        "ch_full",
        "fr_full",
        "it_full",
        "si_full",
        "be_full",
        "nl_full",
        "lu_full",
        "cz_full"
      ]
    },
    {
      "cluster": "eu_central",
      "_why": "The land borders between Germany, Poland, Czechia, Slovakia, Denmark, Lithuania and the northern Balkans. eu_alps covers the Alpine crossings and stops at them; this is everything east and north of that, and it is the largest build in the list.",
      "geofabrik": [
        "europe/dach",
        "europe/poland",
        "europe/czech-republic",
        "europe/slovakia",
        "europe/hungary",
        "europe/denmark",
        "europe/slovenia",
        "europe/croatia",
        "europe/lithuania"
      ],
      "ids": [
        "de_full",
        "at_full",
        "ch_full",
        "pl_full",
        "cz_full",
        "sk_full",
        "hu_full",
        "dk_full",
        "si_full",
        "hr_full",
        "lt_full"
      ]
    },
    {
      "cluster": "eu_iberia",
      "_why": "Spain and Portugal, whose border is long, open and crossed constantly. France used to be in here for the Pyrenees and made the merge 7.0 GB, which was OOM-killed in Valhalla's final binning pass; the Pyrenean crossings are served by eu_pyrenees instead.",
      "geofabrik": [
        "europe/spain",
        "europe/portugal"
      ],
      "ids": [
        "es_full",
        "pt_full"
      ]
    },
    {
      "cluster": "eu_pyrenees",
      "_why": "The Spain-France frontier, cut to the mountains either side of it. A cluster only has to hold the ground a driver crosses, and holding two whole countries to join them was what made the build impossible. It claims es_full and fr_full while holding a strip of each, which is safe: a cluster is chosen by the ground it covers, so a Trek in Andalusia or Normandy falls through to that country's own asset.",
      "geofabrik": [
        "europe/spain",
        "europe/france"
      ],
      "bbox": "-2.2,41.6,3.6,44.2",
      "ids": [
        "es_full",
        "fr_full"
      ]
    },
